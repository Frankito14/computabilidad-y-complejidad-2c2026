
// Clase virtual TM - 1/9/2026
program{
    Sacar_DeColor_(4, Rojo)
}

procedure EscribirFechaVotoFemenino(){
    /*
        PROP: Esribir la fecha de la reglamentacion del voto femenino.
        PREC:
            - Debe haber almenos 2 celdas lindantes al Este.
        OBS: La fecha es 23 de septiembre de 1947
    */
    EscribirFechaConDía_Mes_Año_(23, 9, 1947)
}

procedure EscribirFechaReformaUniversitaria(){
    /*
        PROP: Esribir la fecha de la reforma universitaria.
        PREC:
            - Debe haber almenos 2 celdas lindantes al Este.
        OBS: La fecha es 15 de junio de 1918
    */
    EscribirFechaConDía_Mes_Año_(15, 6, 1918)
}

procedure EscribirFechaConDía_Mes_Año_(día, mes, año){
    /*
        CONTRATO
        PROPOSITO: Representar cualquier fecha dados el día, mes y año
        PRECONDICIONES:
            - Debe haber almenos 2 celdas lindantes al Este.
            - Mes tiene que estar entre 1 y 12
            - Dia tiene que estar entre 1 y 31
            - Año tiene que ser mayor o igual a 0
        PARAMETROS:
            - dia - Numero - Numero del dia de la fecha
            - mes - Numero - Numero del mes de la fecha
            - año - Numero - Numero del año de la fecha
    */
    EscribirDia_(día)
    EscribirMes_(mes)
    EscribirAño_(año)
}

procedure EscribirDia_(unDia){
    /*
        PROP: Escribir el dia *unDia* en la celda actual.
        PREC: 
            - *unDia* tiene que estar entre 1 y 31
        PARAMETROS:
            - dia - Numero - Numero del dia de la fecha
    */
    Poner_DeColor_(unDia, Azul)
}

procedure EscribirMes_(unMes){
    /*
        PROP: Escribir el mes *unMes* en la celda actual.
        PREC: 
            - *unMes* tiene que estar entre 1 y 12
        PARAMETROS:
            - unMes - Numero - Numero del mes de la fecha
    */
    Mover(Este)
    Poner_DeColor_(unMes, Rojo)
}

procedure EscribirAño_(unAño){
    /*
        PROP: Escribir el año *unAño* en la celda actual.
        PREC: 
            - *unAño* tiene que ser mayor o igual a 0
        PARAMETROS:
            - unAño - Numero - Numero del año de la fecha
    */
    Mover(Este)
    Poner_DeColor_(unAño, Verde)
}














//BIBLIOTECA
procedure Poner_DeColor_(unaCantidad, unColor){
    /*
        PROP: Poner *unaCantidad* bolitas de color *unColor*
    */
    repeat(unaCantidad){
        Poner(unColor)
    }
}

procedure Mover_Al_(unaCantidad, unaDireccion){
    //...
    repeat(unaCantidad){
        Mover(unaDireccion)
    }
}

//Sacar_DeColor_(4, Rojo) -> Sacar 4 bolitas de color Rojo

procedure Sacar_DeColor_(cantidadASacar, colorASacar){
    /*
        PROPOSITO: Sacar *cantidadASacar* bolitas de color *colorASacar*
        PRECONDICIONES:
            - Hay al menos *cantidadASacar* bolitas de color *colorASacar* en la celda actual
        PARAMETROS:
            - cantidadASacar - Numero - Cantidad de bolitas a sacar
            - colorASacar - Color - Color a sacar
    */
    repeat(cantidadASacar){
    Sacar(colorASacar)
    }
}


