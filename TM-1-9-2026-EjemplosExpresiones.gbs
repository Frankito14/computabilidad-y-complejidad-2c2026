program{
    /*
    EJEMPLOS DE EXPRESIONES:
    nroBolitas(Rojo) -> 3
    nroBolitas(Azul) -> 0
    previo(Norte) -> Oeste
    siguiente(Norte) -> Este
    opuesto(Norte) -> Sur
    siguiente(Azul) -> Negro
    previo(Azul) -> Verde
    previo(2) -> 1
    (2 + 2) -> 4
    (2 - 1) -> 1
    (2 * 3) -> 6
    (2 ^ 3) -> 8
    7 div 3 -> 2
    7 mod 3 -> 1
    */
    
    //Poner_DeColor_(<Numero>, <Color>)
    //Poner_DeColor_(nroBolitas(Rojo), Verde)
    //Mover(<Direccion>)
    Mover(siguiente(Norte))
}

//BIBLIOTECA
procedure Poner_DeColor_(unaCantidad, unColor){
    /*
        PROP: Poner *unaCantidad* bolitas de color *unColor*
    */
    repeat(unaCantidad){
        Poner(unColor)
    }
}